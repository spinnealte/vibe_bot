.env
.venv/
__pycache__/
*.pyc
logs/
.pytest_cache/
.ruff_cache/

# В legal/ в git - README и копии документов с сайта (legal/site/). Остальное - старые локальные черновики
# согласий (версия 0); тексты, которые показывает бот, теперь в коде (stubbot/services/legal.py).
legal/*
!legal/README.md
!legal/site/

# Веб-приложение: пакеты и кэш обложек из Telegram. Сборка интерфейса (webapp/dist) - в git: Amvera собирает только
# Python, отдаёт её как есть. После правок в webapp/src - `cd webapp && npm run build` и коммит вместе с dist.
webapp/node_modules/
var/

# Туннель для проверки в Telegram (docs/06_webapp.md): официальный cloudflared.exe скачивается отдельно, в git не кладём.
tools/cloudflared/
