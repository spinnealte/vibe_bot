BOT_TOKEN=
# На сервере: socks5://127.0.0.1:1080 (sing-box). Локально — пусто, напрямую.
TELEGRAM_PROXY_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=stubbot
DB_PASSWORD=change-me
DB_NAME=stubbot

# 127.0.0.1, а не localhost: на Windows localhost уходит в IPv6 (::1), а Redis в WSL оттуда не виден
REDIS_URL=redis://127.0.0.1:6379/0

# Владелец бота (единственный админ на старте)
OWNER_TELEGRAM_ID=0

LOG_LEVEL=INFO
LOG_DIR=logs
# Тексты юридических документов: <type>_v<version>.html
LEGAL_DOCS_DIR=legal
TIMEZONE=Europe/Moscow
