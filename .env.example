BOT_TOKEN=
# На сервере: socks5://127.0.0.1:1080 (sing-box). Локально - пусто, напрямую.
TELEGRAM_PROXY_URL=

DB_HOST=localhost
DB_PORT=5432
DB_USER=stubbot
DB_PASSWORD=change-me
DB_NAME=stubbot

# 127.0.0.1, а не localhost: на Windows localhost уходит в IPv6 (::1), а Redis в WSL оттуда не виден
REDIS_URL=redis://127.0.0.1:6379/0

# Владелец бота (всегда админ)
OWNER_TELEGRAM_ID=0
# Другие админы через запятую (видят кнопку «⚙️ Админка»). Пусто - только владелец.
ADMIN_IDS=

LOG_LEVEL=INFO
LOG_DIR=logs
TIMEZONE=Europe/Moscow

# Защита от флуда: не больше FLOOD_LIMIT обращений от одного человека за FLOOD_WINDOW секунд. 0 - выключить.
FLOOD_LIMIT=20
FLOOD_WINDOW=5

# MVP - расписание-афиша без заявок. true - включить заявки, «Мои заявки», «Сообщить о наборе».
APPLICATIONS_ENABLED=false

# Чат менеджера для записи на курсы: https://t.me/<username> (можно короче: t.me/<username> или @<username>).
# Пусто - кнопка «Менеджер» не показывается. Вписывать в свой файл .env, а не сюда: этот файл - образец.
MANAGER_URL=

# Онлайн-оплата заказов (полная версия, нужна APPLICATIONS_ENABLED=true). Руководство - docs/03_online_payments.md.
#   off      - выключена: оплату отмечает админ (по умолчанию);
#   fake     - тестовая оплата без ЮKassa, кнопками «Оплата прошла / не прошла»; только с локальной базой;
#   yookassa - ЮKassa: магазин (тестовый или боевой) задают два ключа ниже.
ONLINE_PAYMENTS=off
# Из личного кабинета ЮKassa → Интеграция → Ключи API. Ключ вписывать только в настройки сервера, не в чат.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ в каждом платеже (когда в ЮKassa подключены «Чеки от ЮKassa» или касса партнёра); значения даёт бухгалтер.
# VAT_CODE: 1 без НДС, 2 - 0%, 3 - 10%, 7 - 5%, 8 - 7%, 11 - 22% (полный список - в руководстве).
# TAX_SYSTEM_CODE: 1 ОСН, 2 УСН доходы, 3 УСН доходы минус расходы, 6 патент; пусто - если система одна.
YOOKASSA_RECEIPTS=false
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_PAYMENT_MODE=full_prepayment
YOOKASSA_PAYMENT_SUBJECT=service

# Веб-приложение (Telegram Mini App) - stubbot/web, docs/06_webapp.md. На Amvera WEBAPP_HOST, WEBAPP_PORT
# и WEBAPP_CACHE_DIR задаёт amvera_start.py - их там не указывать.
WEBAPP_ENABLED=false
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Постоянный https-адрес приложения (домен Amvera или туннель для проверки); пусто - кнопки приложения в боте нет.
WEBAPP_URL=
# Всё - в приложении: после /start одно приветствие с кнопкой приложения, нижнего меню нет. Нужен WEBAPP_URL.
WEBAPP_ONLY=false
# Вход «dev <id>» в обычном браузере - только для разработки и только с локальной базой.
WEBAPP_DEV_AUTH=false
